[PHP]
memory_limit = -1
max_execution_time = 300
max_input_time = 300
max_input_vars = 3000
post_max_size = 100M
upload_max_filesize = 100M

; Date and timezone
date.timezone = America/Sao_Paulo

expose_php = Off
allow_url_fopen = On
allow_url_include = Off

; Performance optimizations
realpath_cache_size = 4096K
realpath_cache_ttl = 600

; OPcache settings (optimized for PHP 8.4)
[opcache]
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 256
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 10000
opcache.max_wasted_percentage = 10
opcache.use_cwd = 1
opcache.validate_timestamps = 0
opcache.revalidate_freq = 0
opcache.save_comments = 0
opcache.enable_file_override = 1
opcache.optimization_level = 0x7FFEBFFF
opcache.preload_user = www-data

; JIT configuration (PHP 8.4 optimized)
opcache.jit_buffer_size = 128M
opcache.jit = 1255

; Session configuration
[Session]
session.save_handler = ${SESSION_HANDLER}
session.save_path = ${SESSION_PATH}
session.name = PHPSESSID

; PostgreSQL settings
[PostgreSQL]
pgsql.allow_persistent = On
pgsql.auto_reset_persistent = Off
pgsql.max_persistent = -1
pgsql.max_links = -1
pgsql.ignore_notice = 0
pgsql.log_notice = 0

; File upload settings
file_uploads = On
upload_tmp_dir = /tmp
max_file_uploads = 20

; Zend settings
zend_extension = opcache

; Redis session configuration (when using Redis)
; Uncomment these lines when using Redis as session handler
; session.save_handler = redis
; session.save_path = "tcp://redis:6379"
